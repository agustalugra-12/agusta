      "Bash(git remote*)",
      "Bash(sudo*)",
      "Bash(systemctl*)",
      "Bash(rm -rf*)",
      "Bash(curl*)",
      "Bash(wget*)",
      "Bash(chmod*)",
      "Bash(chown*)",
